# Required in production: generate a long random secret (never commit the real value)
SESSION_SECRET=replace-with-a-long-random-secret
PORT=3000
NODE_ENV=production

# Optional Deriv OAuth integration. Register this exact callback URL with Deriv.
DERIV_CLIENT_ID=
DERIV_REDIRECT_URI=https://YOUR-DOMAIN/auth/deriv/callback

# Optional AI market analysis provider key. Keep it server-side only.
ANTHROPIC_API_KEY=

# Server-side maximum stake accepted by the existing Rise/Fall trade route.
MAX_TRADE_STAKE=5000
SESSION_LOSS_LIMIT=500
DAILY_STOP_LOSS=500
DAILY_TARGET_PROFIT=500

# WhatsApp signal alerts. Put the REAL values in your host's Environment settings, not in GitHub.
# Phone = digits with country code. Kenya 0707912352 becomes 254707912352
WHATSAPP_PROVIDER=callmebot
WHATSAPP_PHONE=
CALLMEBOT_APIKEY=
# Only if WHATSAPP_PROVIDER=twilio:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
