# Required in production: generate a long random secret (never commit the real value)
SESSION_SECRET=replace-with-a-long-random-secret
PORT=3000
NODE_ENV=production

# Optional Deriv OAuth integration. Register this exact callback URL with Deriv.
DERIV_CLIENT_ID=
DERIV_REDIRECT_URI=https://YOUR-DOMAIN/auth/deriv/callback

# Optional AI market analysis provider key. Keep it server-side only.
ANTHROPIC_API_KEY=

# Server-side maximum stake accepted by the existing Rise/Fall trade route.
MAX_TRADE_STAKE=5000
SESSION_LOSS_LIMIT=500
DAILY_STOP_LOSS=500
DAILY_TARGET_PROFIT=500

# WhatsApp signal alerts. Put the REAL values in your host's Environment settings, not in GitHub.
# Phone = digits with country code. Kenya 0707912352 becomes 254707912352
WHATSAPP_PROVIDER=callmebot
WHATSAPP_PHONE=
CALLMEBOT_APIKEY=
# Only if WHATSAPP_PROVIDER=twilio:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Automatic alerts (server watches the markets itself). Alerts start by themselves once WhatsApp is set.
ALERTS_AUTO=true
ALERT_BANKROLL=            # money you trade with, e.g. 200. Used ONLY for the stake suggestion
ALERT_RISK_PCT=1           # % of bankroll suggested per trade
ALERT_COOLDOWN_MIN=10      # same signal alerts at most once per this many minutes
ALERT_FLUSH_SEC=8          # signals found within this window are sent as ONE message
ALERT_INCLUDE_DIFFERS=false  # Differs qualifies almost every tick, so it is off
